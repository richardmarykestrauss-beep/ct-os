{
  "name": "creative-touch-website-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Creative Touch Website OS — internal AI-assisted website production control plane (MVP)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run security:scan",
    "security:scan": "node scripts/security-scan.mjs",
    "gateway:check": "npx --yes deno check --config supabase/functions/agent-execute/deno.json supabase/functions/agent-execute/index.ts && npm run gateway:bundle && npx --yes deno check --no-config supabase/functions/agent-execute/dist/index.js",
    "gateway:bundle": "node scripts/bundle-edge-function.mjs",
    "mcp:build": "node scripts/bundle-mcp-server.mjs",
    "mcp:start": "node dist/mcp-server/index.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-router": "^1.130.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/router-plugin": "^1.130.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
