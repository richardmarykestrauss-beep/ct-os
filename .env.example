# Creative Touch Website OS — environment template
# Copy to .env.local (git-ignored). Never commit real values.
#
# Two kinds of variables:
#   VITE_*   → public, inlined into the browser bundle (anon key, URLs, mode switches)
#   others   → SERVER-ONLY. Read by the execution gateway (Vite dev middleware / Supabase Edge
#              Function). Vite never exposes them to the browser; scripts/security-scan.mjs proves it.

# ---------------------------------------------------------------- mode
# auto | memory | supabase
#   auto     → Supabase (auth + persistence + HTTP gateway) when URL + anon key are present, else local mode
#   memory   → local mode: named local identity, in-memory U-Proof seed, embedded gateway with stub providers
#   supabase → require Supabase; falls back to memory with a visible reason if it cannot load
VITE_CTOS_REPOSITORY=auto

# ---------------------------------------------------------------- Supabase (public side)
# Apply supabase/migrations/0001_ctos_core.sql and 0002_identity_gateway.sql first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the browser sends POST /agent-execute.
#   unset → "/agent-execute" during `npm run dev` (Vite middleware), else <VITE_SUPABASE_URL>/functions/v1/agent-execute
# VITE_CTOS_GATEWAY_URL=

# ---------------------------------------------------------------- execution gateway (SERVER-ONLY)
# Used by the Vite dev middleware (`npm run dev`). In production, set the same names with
# `supabase secrets set …` for the agent-execute Edge Function (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# are injected there automatically).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# First live provider (CTOS-002). Presence = "Connected" in Settings; absence = "Not configured".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Adapter seams — reported as "Not configured" until their adapters ship (next tickets).
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Dev only: lets unconfigured providers answer with deterministic stubs through the SERVER gateway,
# so the full Supabase path can be exercised without spending tokens. Never set in production.
# CTOS_ALLOW_STUB_PROVIDERS=1
