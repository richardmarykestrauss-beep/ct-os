# Creative Touch Website OS — environment template
# Copy to .env.local (git-ignored). Never commit real values.
#
# Two kinds of variables:
#   VITE_*   → public, inlined into the browser bundle (anon key, URLs, mode switches)
#   others   → SERVER-ONLY. Read by the execution gateway (Vite dev middleware / Supabase Edge
#              Function). Vite never exposes them to the browser; scripts/security-scan.mjs proves it.

# ---------------------------------------------------------------- mode
# auto | memory | supabase
#   auto     → Supabase (auth + persistence + HTTP gateway) when URL + anon key are present, else local mode
#   memory   → local mode: named local identity, in-memory U-Proof seed, embedded gateway with stub providers
#   supabase → require Supabase; falls back to memory with a visible reason if it cannot load
VITE_CTOS_REPOSITORY=auto

# ---------------------------------------------------------------- Supabase (public side)
# Apply supabase/migrations/0001_ctos_core.sql, 0002_identity_gateway.sql and
# 0003_intelligence_model.sql first (in order; 0003 is additive — skills table, provider/skill
# usage columns — and does not change 0001/0002's identity or RLS model).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the browser sends POST /agent-execute.
#   unset → "/agent-execute" during `npm run dev` (Vite middleware), else <VITE_SUPABASE_URL>/functions/v1/agent-execute
# VITE_CTOS_GATEWAY_URL=

# ---------------------------------------------------------------- execution gateway (SERVER-ONLY)
# Used by the Vite dev middleware (`npm run dev`). In production, set the same names with
# `supabase secrets set …` for the agent-execute Edge Function (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# are injected there automatically).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Three live adapters (CTOS-002 shipped OpenAI; CTOS-003 shipped Claude and Gemini) — all implement
# the same AIProvider interface. Presence of a key = "Connected" in Settings; absence = "Not
# configured", never a crash. *_MODEL vars are optional overrides; each adapter has a built-in default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=
# gemini-3.6-flash is CT-OS's tested reliability baseline (CTOS-004A). gemini-3.8-flash is
# supported and can be set here for a higher-tier run when it's healthy, but is not the default -
# a 503/unavailable response falls through to the next provider in the job's fallback sequence
# rather than retrying the same model. See docs/PROVIDER-ADAPTERS.md.
GEMINI_MODEL=gemini-3.6-flash

# Dev only: lets unconfigured providers answer with deterministic stubs through the SERVER gateway,
# so the full Supabase path can be exercised without spending tokens. Never set in production.
# CTOS_ALLOW_STUB_PROVIDERS=1


# ---------------------------------------------------------------- MCP bridge (CTOS-004, local dev, SERVER-ONLY)
# Local ChatGPT/Claude/other MCP client access to CT-OS, via src/mcp/server.ts (stdio transport).
# See docs/MCP-BRIDGE.md. Run: npm run mcp:build && npm run mcp:start
# A random 32+ char secret. Whoever configures their MCP client with this value IS the external
# assistant identity below - there is no per-request auth on stdio, so guard this like a password.
CTOS_MCP_TOKEN=
# chatgpt | claude | automation | other
CTOS_MCP_CLIENT_NAME=chatgpt-local
CTOS_MCP_CLIENT_TYPE=chatgpt
# READ_ONLY | GREEN_WRITE — see docs/MCP-BRIDGE.md "Permission ceiling". Start with READ_ONLY.
CTOS_MCP_CEILING=READ_ONLY
