# Creative Touch Website OS — environment template
# Copy to .env.local (git-ignored) for local dev. Never commit real values.
#
# Two kinds of variables:
#   VITE_*   → public, inlined into the browser bundle (anon key, URLs, mode switches)
#   others   → SERVER-ONLY. Read by the execution gateway (Vite dev middleware / Vercel functions in
#              api/* / Supabase Edge Function). Vite never exposes them to the browser;
#              scripts/security-scan.mjs proves it by grepping the built bundle for these values.
#
# Where each variable is SET differs by environment; the NAMES are identical everywhere:
#   Local dev (`npm run dev`)  → .env.local (this file, copied)
#   Vercel (api/*.ts)          → Vercel project → Settings → Environment Variables (mark server-only
#                                 vars as "Sensitive"; do NOT prefix them with VITE_ or they leak
#                                 into the client bundle). Scope to Production/Preview as needed.
#   Supabase Edge Function     → `supabase secrets set NAME=value` (SUPABASE_URL /
#                                 SUPABASE_SERVICE_ROLE_KEY are injected there automatically)
# Only ONE of "Vercel api/*" or "Supabase Edge Function" needs to be configured for execution —
# see VITE_CTOS_GATEWAY_URL below. Persistence (Supabase Postgres + RLS) is independent of which
# execution backend you pick.

# ---------------------------------------------------------------- mode
# auto | memory | supabase
#   auto     → Supabase (auth + persistence + HTTP gateway) when URL + anon key are present, else local mode
#   memory   → local mode: named local identity, in-memory U-Proof seed, embedded gateway with stub providers
#   supabase → require Supabase; falls back to memory with a visible reason if it cannot load
VITE_CTOS_REPOSITORY=auto

# ---------------------------------------------------------------- Supabase (public side)
# Apply supabase/migrations/*.sql IN ORDER before pointing the app at a project:
#   0001_ctos_core.sql          — clients/projects/tickets/agents/artifacts/jobs/... (CTOS-001)
#   0002_identity_gateway.sql   — profiles/invites/RLS/permission model (CTOS-002)
#   0003_intelligence_model.sql — skills (CTOS-003, additive)
#   0004_ctos_extended_tables.sql — CTOS-005A/005B/006/007A tables: build packs, revision control,
#                                    visual intelligence, WordPress site connections + write engine,
#                                    website audit requests/findings (CTOS-008, additive). Without
#                                    this migration, Supabase mode throws on load as soon as any of
#                                    those OSData collections is read (see src/services/supabase/mapping.ts TABLES).
# Via Supabase SQL Editor (paste each file, in order) or `supabase db push` with the CLI linked to the project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the browser sends POST /agent-execute (and GET .../health).
#   unset in dev        → "/agent-execute" (Vite middleware, vite.config.ts ctosGatewayPlugin())
#   unset in production  → <VITE_SUPABASE_URL>/functions/v1/agent-execute (Supabase Edge Function)
#   set to "/agent-execute" on Vercel → routed by vercel.json to api/agent-execute.ts (same path
#     the app already uses locally, so no other frontend code needs to change)
#   set to "/api/agent-execute" on Vercel → the same Vercel function, called directly
# VITE_CTOS_GATEWAY_URL=

# ---------------------------------------------------------------- execution gateway (SERVER-ONLY)
# Read identically by three call sites — src/gateway/node.ts (Vite dev middleware AND Vercel's
# api/agent-execute.ts + api/agent-execute/health.ts, which import it directly) and
# supabase/functions/agent-execute/index.ts (Deno Edge Function, same core, different wrapper).
# Set once per deployment target using that target's own secret mechanism (see the note above).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dev-only alternative to a configured Supabase project: the browser posts its own job context and
# src/gateway/node.ts runs it against the LIVE server provider registry (real keys, no browser
# exposure) with no server-side job store. Only takes effect when Supabase is NOT configured above.
# Never set this in production — Vercel and the Supabase Edge Function always require real Supabase
# config and ignore this flag's intent (see localGatewayEnabled() in src/gateway/node.ts).
# CTOS_LOCAL_NO_SUPABASE=1

# Three live adapters (CTOS-002 shipped OpenAI; CTOS-003 shipped Claude and Gemini) — all implement
# the same AIProvider interface. Presence of a key = "Connected" in Settings; absence = "Not
# configured", never a crash. *_MODEL vars are optional overrides; each adapter has a built-in default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=
# gemini-3.6-flash is CT-OS's tested reliability baseline (CTOS-004A). gemini-3.8-flash is
# supported and can be set here for a higher-tier run when it's healthy, but is not the default -
# a 503/unavailable response falls through to the next provider in the job's fallback sequence
# rather than retrying the same model. See docs/PROVIDER-ADAPTERS.md.
GEMINI_MODEL=gemini-3.6-flash

# Dev only: lets unconfigured providers answer with deterministic stubs through the SERVER gateway,
# so the full Supabase path can be exercised without spending tokens. Never set in production.
# CTOS_ALLOW_STUB_PROVIDERS=1


# ---------------------------------------------------------------- MCP bridge (CTOS-004, local dev, SERVER-ONLY)
# Local ChatGPT/Claude/other MCP client access to CT-OS, via src/mcp/server.ts (stdio transport).
# See docs/MCP-BRIDGE.md. Run: npm run mcp:build && npm run mcp:start
# A random 32+ char secret. Whoever configures their MCP client with this value IS the external
# assistant identity below - there is no per-request auth on stdio, so guard this like a password.
CTOS_MCP_TOKEN=
# chatgpt | claude | automation | other
CTOS_MCP_CLIENT_NAME=chatgpt-local
CTOS_MCP_CLIENT_TYPE=chatgpt
# READ_ONLY | GREEN_WRITE — see docs/MCP-BRIDGE.md "Permission ceiling". Start with READ_ONLY.
CTOS_MCP_CEILING=READ_ONLY

# ---------------------------------------------------------------- WordPress REST adapter (CTOS-006R1, SERVER-ONLY)
# Used by RealWordPressRestAdapter for controlled staging writes.
# Set up a WordPress Application Password: WP Admin → Users → Profile → Application Passwords.
# The user must have editor role minimum; administrator is not required.
# NEVER commit real values. These must never appear in logs, artifacts, or the browser bundle.
WP_TEST_SITE_URL=
WP_TEST_USERNAME=
WP_TEST_APP_PASSWORD=
