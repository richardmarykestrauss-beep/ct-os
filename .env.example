# Creative Touch Website OS — environment template (copy to .env.local; never commit real values)

# Repository selection: auto | memory | supabase
#   auto     → Supabase when URL + anon key are present, otherwise in-memory
#   memory   → always in-memory (seeded U-Proof state, resets on reload)
#   supabase → require Supabase; the app shows an error and falls back to memory if it cannot load
VITE_CTOS_REPOSITORY=auto

# Supabase (control plane persistence). Apply supabase/migrations/*.sql first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Intelligence providers — NOT USED in Phase 1. Presence is only reported as "configured" in Settings.
# Real adapters arrive in a later ticket and will read these server-side, never from the browser bundle.
# VITE_ANTHROPIC_API_KEY=
# VITE_OPENAI_API_KEY=
# VITE_GEMINI_API_KEY=
